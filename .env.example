# Copy to `.env.local` for local dev. Server loads it automatically (server/index.ts).
#
# ── 1) AI (server only) ─────────────────────────────────────────────────────
# Decart realtime. This kiosk uses Lucy 2.6 (`lucy-2.6`) for creative effects.
# Never put the key in VITE_*.
DECART_API_KEY=
# Optional max WebRTC session duration in seconds (default 180):
# DECART_MAX_SESSION_SECONDS=180
#
# Legacy Gemini (optional fallback):
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# ── 2) API gate (your server, NOT Google) ───────────────────────────────────
# Same secret in both lines. Server checks X-API-Key on /api/*.
# Local: optional (if unset, /api has no auth in development).
# Production: API_KEY required at runtime or the app refuses to start.
API_KEY=local-dev-key
VITE_KIOSK_API_KEY=local-dev-key

# ── 3) Client pack (Vite — baked in at build / alias at `npm run dev`) ─────
# Default pack is navidad (live claymation effects). Plain `npm run dev` is enough.
VITE_CLIENT_ID=navidad

# ── Optional ──────────────────────────────────────────────────────────────────
# Image model/size — defaults: gemini-3.1-flash-image @ 1K (identity / try-on quality).
# Latency A/B (weaker identity): gemini-3.1-flash-lite-image. Prior: gemini-2.5-flash-image.
# Keep GEMINI_IMAGE_SIZE=1K (avoid 2K).
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_IMAGE_SIZE=1K
# Video model — default gemini-omni-flash-preview (Interactions, 3s).
# Veo Fast: GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
# GEMINI_VIDEO_MODEL=gemini-omni-flash-preview
# PORT=8080
# Optional extra API tokens (in addition to API_KEY):
# KIOSK_TOKENS=extra-token-a,extra-token-b
# GEMINI_API_KEY_BACKUP=
# Sideways-mounted camera only — leave unset for normal laptop/phone cams.
# VITE_CAMERA_ROTATION_DEG=-90
# VITE_WARDROBE_FEED=false
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# DEV only: jump straight into studio (skip capture). Same as ?studio=1
# VITE_DEV_STUDIO_SEED=true
# DEV / spike: MediaPipe face landmark analysis at capture (before Gemini). Default off.
# VITE_FACE_FIT_ANALYSIS=true
# Reserved future fit-recommendation switch; currently has no ranking/UI effect.
# VITE_FACE_FIT_RECOMMENDATIONS=true
# DEV only: enable the consent-gated local calibration dataset download.
# VITE_FACE_FIT_FIXTURE_EXPORT=true
# DEV only: show iris-scale-v1 and public PoC frame-width comparisons in calibration.
# VITE_FACE_FIT_SIZE_SANDBOX=true
