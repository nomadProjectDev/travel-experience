{
  "name": "navidad-effects-mupi",
  "description": "Portrait MUPI of live Decart creative effects in a Christmas claymation world, powered by Lucy 2.6.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "NODE_ENV=production tsx server.ts",
    "dev": "node tooling/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "eslint": "eslint .",
    "new-client": "node tooling/new-client.mjs",
    "verify-clients": "node tooling/verify-client-pack.mjs",
    "face-fit:validate": "node tooling/face-fit-validate.mjs",
    "face-fit:report": "node tooling/face-fit-report.mjs",
    "face-fit:test": "node --test validation/face-fit/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.14",
    "@google/genai": "^2.18.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^11.2.12",
    "howler": "^2.2.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-webcam": "^7.2.0",
    "tailwind-merge": "^2.4.0",
    "tsx": "^4.21.0",
    "use-sound": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@types/express": "^5.0.6",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.2.0",
    "vitest": "^4.0.8"
  }
}
